# --- Telegram ---
BOT_TOKEN=123456:ABC...
# Birinchi super admin(lar) Telegram ID si, vergul bilan (TZ 2.2)
SUPERADMIN_IDS=111111111
# Adminlar guruhi ID si (cheklar shu yerga keladi). Guruhda /setgroup bilan ham o'rnatiladi
ADMIN_GROUP_ID=
# Texnik xatolar uchun chat (ixtiyoriy)
TECH_CHAT_ID=
# "Admin bilan bog'lanish" tugmasi uchun username (@ siz, ixtiyoriy)
SUPPORT_USERNAME=

# --- Baza ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darslik_bot
REDIS_URL=redis://localhost:6379

# --- Ishga tushirish ---
# polling (lokal) yoki webhook (server)
BOT_MODE=polling
WEBHOOK_URL=https://example.uz/telegram
WEBHOOK_SECRET=change-me-random-string
PORT=8080
LOG_LEVEL=info

# --- Admin panel ---
# Kamida 32 belgili tasodifiy satr: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Bazadagi bot tokenini shifrlash kaliti (ixtiyoriy, bo'lmasa JWT_SECRET dan)
ENCRYPTION_KEY=
# Frontend manzili (CORS uchun). Productionda panel shu serverning o'zidan ochiladi
CLIENT_URL=http://localhost:5173
# Birinchi SUPER_ADMIN (npm run db:seed yaratadi). Parol bo'lmasa tasodifiy yaratiladi va chop etiladi
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
