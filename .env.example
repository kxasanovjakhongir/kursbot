# Nusxa oling: cp .env.example .env — va qiymatlarni to'ldiring.
# Bu faylga HAQIQIY secret yozmang: u git'da saqlanadi. .env esa .gitignore da.

# --- Telegram ---
# @BotFather dan olingan token (TELEGRAM_BOT_TOKEN nomi ham qabul qilinadi)
BOT_TOKEN=
# Birinchi super admin(lar) Telegram ID si, vergul bilan (TZ 2.2)
SUPERADMIN_IDS=
# Adminlar guruhi ID si (cheklar shu yerga keladi). Guruhda /setgroup bilan ham o'rnatiladi
ADMIN_GROUP_ID=
# Texnik xatolar uchun chat (ixtiyoriy)
TECH_CHAT_ID=
# "Admin bilan bog'lanish" tugmasi uchun username (@ siz, ixtiyoriy)
SUPPORT_USERNAME=

# --- Baza ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darslik_bot
# Ulanishlar puli (bitta instance). Umumiy: instanslar × DB_POOL_SIZE < PostgreSQL max_connections
DB_POOL_SIZE=20
# Bo'sh ulanishni kutish, soniya (oshsa so'rov xato bilan tugaydi — osilib qolmaydi)
DB_POOL_TIMEOUT=15
# Hozircha ishlatilmaydi: umumiy holat, qulf va navbat PostgreSQL da (Redis shart emas)
REDIS_URL=

# --- Ishga tushirish ---
# polling (lokal) yoki webhook (server)
BOT_MODE=polling
# Faqat webhook rejimida majburiy
WEBHOOK_URL=
# Webhook rejimida: kamida 16 belgi, faqat A-Z a-z 0-9 _ -  (openssl rand -hex 24)
WEBHOOK_SECRET=
PORT=8080
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Unumdorlik va ishonchlilik ---
# Bir vaqtda qayta ishlanadigan update lar (bitta chat ichida tartib baribir saqlanadi)
BOT_CONCURRENCY=50
# Webhook: Telegram bir vaqtda ochadigan ulanishlar (1–100)
WEBHOOK_MAX_CONNECTIONS=40
# SIGTERM da joriy ishlar tugashini kutish, ms
SHUTDOWN_TIMEOUT_MS=15000
# Xabarlar tarixi va analitika hodisalari saqlanadigan muddat (kun); 0 — o'chirilmaydi
MESSAGE_RETENTION_DAYS=180
EVENT_RETENTION_DAYS=365
# /metrics (Prometheus) uchun Bearer token, kamida 16 belgi (openssl rand -hex 24). Bo'sh — /metrics o'chiq
METRICS_TOKEN=

# --- Tracking ---
# Serverning ochiq HTTPS manzili: tracking link https://domen.uz/l/<kod> (bosishlarni sanaydi).
# Bo'sh bo'lsa panelda faqat t.me/<bot>?start=<kod> linki chiqadi
PUBLIC_URL=

# --- CRM ---
# Telefon ulashilganda lid shu manzilga POST qilinadi (first_name, last_name, phone, telegram_id, telegram_username).
# URL ichidagi kalit maxfiy — haqiqiy qiymatni faqat .env.production ga yozing. Bo'sh — integratsiya o'chiq
CRM_WEBHOOK_URL=

# --- Admin panel ---
# Kamida 32 belgili tasodifiy satr: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Bazadagi bot tokenini shifrlash kaliti (ixtiyoriy, bo'lmasa JWT_SECRET dan hosil qilinadi)
ENCRYPTION_KEY=
# Frontend manzili (CORS uchun), vergul bilan bir nechta. Productionda panel shu serverning o'zidan ochiladi
CLIENT_URL=http://localhost:5173
# Birinchi SUPER_ADMIN (npm run db:seed yaratadi). Parol bo'sh bo'lsa tasodifiy yaratiladi va bir marta chop etiladi
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Kurs darslari (videolar) ---
# true — dars videolarini forward qilish/saqlab olish taqiqlanadi (Telegram protect_content). Standart: false
LESSON_PROTECT_CONTENT=false
