# --- Telegram ---
BOT_TOKEN=123456:ABC...
# Birinchi super admin(lar) Telegram ID si, vergul bilan (TZ 2.2)
SUPERADMIN_IDS=111111111
# Adminlar guruhi ID si (cheklar shu yerga keladi). Guruhda /setgroup bilan ham o'rnatiladi
ADMIN_GROUP_ID=
# Texnik xatolar uchun chat (ixtiyoriy)
TECH_CHAT_ID=
# "Admin bilan bog'lanish" tugmasi uchun username (@ siz, ixtiyoriy)
SUPPORT_USERNAME=

# --- Baza ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darslik_bot
REDIS_URL=redis://localhost:6379

# --- Ishga tushirish ---
# polling (lokal) yoki webhook (server)
BOT_MODE=polling
WEBHOOK_URL=https://example.uz/telegram
WEBHOOK_SECRET=change-me-random-string
PORT=8080
LOG_LEVEL=info
