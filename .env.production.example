# Production sozlamalari. Serverda: cp .env.production.example .env.production && chmod 600 .env.production
# Bu faylni HECH QACHON git'ga qo'shmang (.gitignore da). Qiymatlar: openssl rand -hex 32

# --- Telegram ---
BOT_TOKEN=
SUPERADMIN_IDS=
ADMIN_GROUP_ID=
TECH_CHAT_ID=
SUPPORT_USERNAME=

# --- Webhook (production) ---
BOT_MODE=webhook
# nginx orqali ochiq HTTPS manzil; yo'l qismi maxfiy bo'lishi shart emas (secret token tekshiriladi)
WEBHOOK_URL=https://bot.example.uz/telegram/webhook
# openssl rand -hex 24  (faqat A-Z a-z 0-9 _ -)
WEBHOOK_SECRET=
WEBHOOK_MAX_CONNECTIONS=40

# --- Baza (docker compose DATABASE_URL ni o'zi yig'adi) ---
# openssl rand -hex 24
POSTGRES_PASSWORD=
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=15

# --- Admin panel ---
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# openssl rand -hex 32 — bazadagi bot tokenini shifrlash (berilmasa JWT_SECRET dan hosil qilinadi)
ENCRYPTION_KEY=
CLIENT_URL=https://bot.example.uz
ADMIN_EMAIL=
# Bo'sh qoldiring — seed tasodifiy parol yaratib, bir marta chop etadi
ADMIN_PASSWORD=

# --- Tracking (reklama linklari https://bot.example.uz/l/<kod>) ---
PUBLIC_URL=https://bot.example.uz

# CRM webhook (ixtiyoriy): telefon ulashilganda lid yuboriladi. Bo'sh — o'chiq
CRM_WEBHOOK_URL=

# --- Ishlash ---
PORT=8080
LOG_LEVEL=info
BOT_CONCURRENCY=50
SHUTDOWN_TIMEOUT_MS=15000
MESSAGE_RETENTION_DAYS=180
EVENT_RETENTION_DAYS=365
# /metrics uchun (openssl rand -hex 24); bo'sh — o'chiq
METRICS_TOKEN=

# --- Kurs darslari (videolar) ---
# true — dars videolarini forward qilish/saqlab olish taqiqlanadi (Telegram protect_content). Standart: false
LESSON_PROTECT_CONTENT=false

# --- Email: admin panel "Parolni unutdim" (tasdiqlash kodi) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
