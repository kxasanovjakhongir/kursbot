// TZ v2.1, 10-bo'lim. Vaqtlar UTC da (timestamptz), pul summalari butun so'mda (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  channel
  bundle
}

enum FilesMode {
  auto
  semi
  manual
}

enum OrderStatus {
  new
  receipt_sent
  rejected
  approved
  joined
  expired
  cancelled
  refunded
}

enum PaymentMethod {
  card
  payme
  click
}

enum ReceiptFileType {
  photo
  pdf
  image
}

enum ReminderKind {
  pay_1
  pay_2
  pay_3
  video
  upsell
  join
}

enum AdminRole {
  admin
  superadmin
}

enum PromoKind {
  amount
  percent
}

enum MessageDirection {
  incoming
  outgoing
}

enum MessageType {
  text
  photo
  video
  document
  other
}

enum BroadcastAudience {
  all
  active
  specific
  // Kamida bitta tasdiqlangan xaridi borlar
  buyers
  // Hali xarid qilmaganlar
  non_buyers
  // Telegram adminlari (rol bo'yicha)
  admins
  // Ma'lum mahsulot egalari (Broadcast.productId)
  product
}

// Kanal kirishi nima uchun bekor qilingan
enum GrantRevokeReason {
  expired // muddati tugagan (avtomatik)
  removed // admin kanaldan chiqargan
  banned // foydalanuvchi cheklangan
}

enum NotificationKind {
  info
  success
  warning
  order
  message
}

enum BroadcastStatus {
  pending
  sending
  completed
  failed
}

enum RecipientStatus {
  pending
  sent
  failed
  skipped
}

model User {
  id           BigInt    @id @default(autoincrement())
  telegramId   BigInt    @unique @map("telegram_id")
  username     String?
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  languageCode String?   @map("language_code")
  isBot        Boolean   @default(false) @map("is_bot")
  phone        String?
  isForeign    Boolean   @default(false) @map("is_foreign")
  firstSource  String?   @map("first_source")
  firstProduct String?   @map("first_product")
  // Oxirgi START dagi mahsulot va manba — oqim davomida ishlatiladi
  lastProduct  String?   @map("last_product")
  lastSource   String?   @map("last_source")
  // Oxirgi kampaniya linki (bot → buyurtma yo'lida kontekst saqlanadi)
  lastLinkId   Int?      @map("last_link_id")
  // Birinchi kampaniya linki (first-touch) — keyingi linklar uni o'zgartirmaydi
  firstLinkId  Int?      @map("first_link_id")
  // Ro'yxatdan o'tgan vaqt: telefon raqamini ulashgan payt
  registeredAt DateTime? @map("registered_at") @db.Timestamptz
  lastLinkAt   DateTime? @map("last_link_at") @db.Timestamptz
  // Foydalanuvchi botni bloklagan (Telegram 403)
  isBlocked    Boolean   @default(false) @map("is_blocked")
  // Admin tomonidan cheklangan: bot unga javob bermaydi, broadcast yuborilmaydi
  isBanned     Boolean   @default(false) @map("is_banned")
  bannedAt     DateTime? @map("banned_at") @db.Timestamptz
  // Bot interfeysi tili (uz/ru/en). null — sozlamalardagi default_language
  language     String?
  // Yangiliklar (broadcast) olishga rozilik. Buyurtma xabarlari har doim yuboriladi
  newsEnabled  Boolean   @default(true) @map("news_enabled")
  referrerId   BigInt?   @map("referrer_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz

  orders              Order[]
  grants              AccessGrant[]
  lastLink            CampaignLink?        @relation("UserLastLink", fields: [lastLinkId], references: [id], onDelete: SetNull)
  firstLink           CampaignLink?        @relation("UserFirstLink", fields: [firstLinkId], references: [id], onDelete: SetNull)
  linkVisits          LinkVisit[]
  reminders           Reminder[]
  events              Event[]
  messages            Message[]
  broadcastRecipients BroadcastRecipient[]
  notifications       Notification[]

  @@index([createdAt])
  @@index([lastSeenAt])
  @@index([firstLinkId])
  @@index([registeredAt])
  @@map("users")
}

model Product {
  id             Int         @id @default(autoincrement())
  code           String      @unique
  title          String
  description    String      @default("")
  price          Int         @default(0)
  oldPrice       Int?        @map("old_price")
  videoFileId    String?     @map("video_file_id")
  type           ProductType @default(channel)
  channelId      BigInt?     @map("channel_id")
  // type = bundle bo'lsa — tarkibidagi mahsulot kodlari
  bundleCodes    String[]    @default([]) @map("bundle_codes")
  filesMode      FilesMode   @default(auto) @map("files_mode")
  fileMessageIds BigInt[]    @default([]) @map("file_message_ids")
  accessDays     Int?        @map("access_days")
  // Kurs ma'lumotlari (ixtiyoriy) — botda bo'lim tugmalari sifatida ko'rsatiladi
  duration       String?
  lessonsCount   Int?        @map("lessons_count")
  audience       String?
  startDate      DateTime?   @map("start_date") @db.Date
  teacher        String?
  benefits       String?
  program        String?
  isActive       Boolean     @default(true) @map("is_active")
  // Paneldan o'chirilgan (buyurtmalar tarixi saqlanishi uchun yozuv qoladi, hamma joyda yashiriladi)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz
  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  orders     Order[]
  grants     AccessGrant[]
  links      CampaignLink[]
  promos     PromoCode[]
  broadcasts Broadcast[]
  lessons    Lesson[]

  @@map("products")
}

model Order {
  id                BigInt        @id @default(autoincrement())
  userId            BigInt        @map("user_id")
  productId         Int           @map("product_id")
  amount            Int
  discount          Int           @default(0)
  promoId           Int?          @map("promo_id")
  cardId            Int?          @map("card_id")
  status            OrderStatus   @default(new)
  attempts          Int           @default(0)
  // BR-06: "Summa kam" bo'lganda yetishmayotgan summa
  shortfall         Int?
  reviewedById      Int?          @map("reviewed_by")
  // Admin paneldan tasdiqlangan/rad etilgan bo'lsa
  reviewedByPanelId Int?          @map("reviewed_by_panel_user_id")
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz
  rejectReason      String?       @map("reject_reason")
  adminNote         String?       @map("admin_note")
  expiresAt         DateTime      @map("expires_at") @db.Timestamptz
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz
  source            String?
  // Buyurtma qaysi kampaniya linki orqali kelgan (atribusiya: oxirgi link, 30 kun)
  linkId            Int?          @map("link_id")
  paymentMethod     PaymentMethod @default(card) @map("payment_method")
  // Admin paneldan bekor qilingan (ochiq → cancelled, to'langan → refunded)
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledById     Int?          @map("cancelled_by_panel_user_id")
  cancelReason      String?       @map("cancel_reason")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user            User          @relation(fields: [userId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
  promo           PromoCode?    @relation(fields: [promoId], references: [id])
  card            Card?         @relation(fields: [cardId], references: [id])
  reviewedBy      Admin?        @relation(fields: [reviewedById], references: [id])
  reviewedByPanel PanelUser?    @relation("OrderReviewedByPanel", fields: [reviewedByPanelId], references: [id], onDelete: SetNull)
  cancelledBy     PanelUser?    @relation("OrderCancelledByPanel", fields: [cancelledById], references: [id], onDelete: SetNull)
  receipts        Receipt[]
  grants          AccessGrant[]
  reminders       Reminder[]
  // Onlayn to'lov urinishlari (Payme / Click)
  transactions    PaymentTransaction[]
  // Admin panel: buyurtmalar ro'yxati (status filtri bilan va filtrsiz, yangilari birinchi)
  link            CampaignLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([userId, productId, status])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([linkId])
  // Analitika: daromad va xaridlar vaqt bo\'yicha
  @@index([paidAt])
  @@index([createdAt])
  @@map("orders")
}

/// Payme / Click tranzaksiyasi. state: 1 — yaratilgan (kutilmoqda), 2 — to'langan,
/// -1 — to'lovdan oldin bekor qilingan, -2 — to'lovdan keyin bekor qilingan (pul qaytarilgan).
/// Payme holatlari bilan bir xil; Click ham shu qiymatlardan foydalanadi (prepare=1, complete=2, xato=-1).
model PaymentTransaction {
  id           BigInt        @id @default(autoincrement())
  provider     PaymentMethod
  // Payme: params.id; Click: click_trans_id
  externalId   String        @map("external_id")
  orderId      BigInt        @map("order_id")
  // So'mda (Payme tiyinda yuboradi — 100 ga bo'linib saqlanadi)
  amount       Int
  state        Int           @default(1)
  // Payme bekor qilish sababi (1–10) yoki Click xato kodi
  reason       Int?
  // Payme: params.time (provayder tizimidagi yaratilish vaqti, ms). GetStatement shu bo'yicha filtrlaydi
  providerTime BigInt?       @map("provider_time")
  performedAt  DateTime?     @map("performed_at") @db.Timestamptz
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz
  // Click: click_paydoc_id va boshqa qo'shimcha maydonlar
  meta         Json?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, externalId])
  @@index([orderId])
  @@index([provider, providerTime])
  @@map("payment_transactions")
}

model Receipt {
  id             BigInt          @id @default(autoincrement())
  orderId        BigInt          @map("order_id")
  fileId         String          @map("file_id")
  fileUniqueId   String          @map("file_unique_id")
  fileType       ReceiptFileType @map("file_type")
  isDuplicate    Boolean         @default(false) @map("is_duplicate")
  adminChatId    BigInt?         @map("admin_chat_id")
  adminMessageId BigInt?         @map("admin_message_id")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([fileUniqueId])
  @@index([orderId])
  @@map("receipts")
}

model AccessGrant {
  id               BigInt             @id @default(autoincrement())
  userId           BigInt             @map("user_id")
  productId        Int                @map("product_id")
  orderId          BigInt             @map("order_id")
  inviteLink       String?            @unique @map("invite_link")
  linkExpiresAt    DateTime?          @map("link_expires_at") @db.Timestamptz
  joinedAt         DateTime?          @map("joined_at") @db.Timestamptz
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz
  revokeReason     GrantRevokeReason? @map("revoke_reason")
  // Muddat tugashidan oldingi eslatma yuborilgan vaqt (takror yuborilmasligi uchun)
  expiryRemindedAt DateTime?          @map("expiry_reminded_at") @db.Timestamptz
  filesSentAt      DateTime?          @map("files_sent_at") @db.Timestamptz
  // null = bot o'zi yuborgan
  filesSentById    Int?               @map("files_sent_by")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz

  user        User    @relation(fields: [userId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  order       Order   @relation(fields: [orderId], references: [id])
  filesSentBy Admin?  @relation(fields: [filesSentById], references: [id])

  @@index([userId, productId])
  // Broadcast: "mahsulot egalari" auditoriyasi
  @@index([productId])
  // Muddat vazifasi uchun qisman indeks (WHERE revoked_at IS NULL AND expires_at IS NOT NULL) migratsiyada SQL bilan
  @@map("access_grants")
}

model Reminder {
  id          BigInt       @id @default(autoincrement())
  userId      BigInt       @map("user_id")
  orderId     BigInt?      @map("order_id")
  kind        ReminderKind
  sendAt      DateTime     @map("send_at") @db.Timestamptz
  sentAt      DateTime?    @map("sent_at") @db.Timestamptz
  cancelledAt DateTime?    @map("cancelled_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, sentAt, cancelledAt])
  @@map("reminders")
}

model Card {
  id           Int       @id @default(autoincrement())
  // To'liq raqam faqat shu jadvalda saqlanadi
  number       String
  numberMasked String    @map("number_masked")
  holder       String
  bank         String?
  monthlyLimit Int?      @map("monthly_limit")
  isActive     Boolean   @default(true) @map("is_active")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  orders Order[]

  @@map("cards")
}

model PromoCode {
  id         Int       @id @default(autoincrement())
  code       String    @unique
  kind       PromoKind
  value      Int
  productId  Int?      @map("product_id")
  maxUses    Int?      @map("max_uses")
  used       Int       @default(0)
  validUntil DateTime? @map("valid_until") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  product Product? @relation(fields: [productId], references: [id])
  orders  Order[]

  @@map("promo_codes")
}

model Admin {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique @map("telegram_id")
  name       String?
  role       AdminRole @default(admin)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  reviewedOrders Order[]
  filesSent      AccessGrant[]
  messages       Message[]
  auditLogs      AuditLog[]
  lessons        Lesson[]

  @@map("admins")
}

model Setting {
  key   String @id
  value Json

  @@map("settings")
}

/// Bot yuborgan, support profiliga URL tugmasi bor xabarlar. Paneldan username o'zgartirilsa,
/// fon vazifasi shu xabarlardagi tugmalarni yangi havolaga almashtiradi (eski xabarlar ham yangisini ochadi)
model SupportButtonMessage {
  chatId    BigInt   @map("chat_id")
  messageId Int      @map("message_id")
  /// Tugmadagi support havolasi (https://t.me/<username>)
  url       String
  /// Xabarning to'liq inline klaviaturasi — tahrirlashda boshqa tugmalar saqlanadi
  markup    Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@id([chatId, messageId])
  @@index([url])
  @@index([updatedAt])
  @@map("support_button_messages")
}

model Text {
  key  String
  lang String @default("uz")
  body String

  @@id([key, lang])
  @@map("texts")
}

model Event {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  name      String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([name, createdAt])
  @@index([userId, name])
  // Eski hodisalarni tozalash (EVENT_RETENTION_DAYS)
  @@index([createdAt])
  @@map("events")
}

model Message {
  id                BigInt           @id @default(autoincrement())
  userId            BigInt           @map("user_id")
  direction         MessageDirection
  messageType       MessageType      @default(text) @map("message_type")
  telegramMessageId Int?             @map("telegram_message_id")
  text              String?
  adminId           Int?             @map("admin_id")
  adminMessageId    BigInt?          @map("admin_message_id")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id])
  admin Admin? @relation(fields: [adminId], references: [id])

  @@index([adminMessageId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("messages")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  adminId   Int?     @map("admin_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  admin Admin? @relation(fields: [adminId], references: [id])

  @@index([entity, entityId])
  @@map("audit_log")
}

// ---------- Veb admin panel ----------

/**
 * Admin panelga login qiladigan xodim (Telegram adminlaridan alohida)
 */
model PanelUser {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  name               String
  passwordHash       String    @map("password_hash")
  // Telegram hisobi: berilsa shu odam botda ham admin (xuddi shu rol bilan) — panel bilan sinxron
  telegramId         BigInt?   @unique @map("telegram_id")
  role               AdminRole @default(admin)
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  // "Parolni unutdim" (OTP) orqali kirgan — yangi parol o'rnatmaguncha panelning boshqa bo'limlari yopiq
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  otps            AdminOtp[]
  broadcasts      Broadcast[]
  activityLogs    ActivityLog[]
  reviewedOrders  Order[]        @relation("OrderReviewedByPanel")
  cancelledOrders Order[]        @relation("OrderCancelledByPanel")
  campaignLinks   CampaignLink[]

  @@map("panel_users")
}

/// "Parolni unutdim": emailga yuborilgan bir martalik kod. Kodning o'zi saqlanmaydi — faqat bcrypt xeshi
model AdminOtp {
  id        Int       @id @default(autoincrement())
  adminId   Int       @map("admin_id")
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  admin PanelUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@map("admin_otps")
}

model Broadcast {
  id             Int               @id @default(autoincrement())
  messageType    MessageType       @map("message_type")
  text           String?
  fileId         String?           @map("file_id")
  fileName       String?           @map("file_name")
  audience       BroadcastAudience
  // audience = product bo'lsa
  productId      Int?              @map("product_id")
  status         BroadcastStatus   @default(pending)
  total          Int               @default(0)
  sent           Int               @default(0)
  failed         Int               @default(0)
  skipped        Int               @default(0)
  // Ikki marta yuborishdan himoya: frontend har bir forma uchun bitta kalit yuboradi
  idempotencyKey String            @unique @map("idempotency_key")
  createdById    Int?              @map("created_by")
  startedAt      DateTime?         @map("started_at") @db.Timestamptz
  finishedAt     DateTime?         @map("finished_at") @db.Timestamptz
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  createdBy  PanelUser?           @relation(fields: [createdById], references: [id])
  product    Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  recipients BroadcastRecipient[]

  @@index([createdAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id                BigInt          @id @default(autoincrement())
  broadcastId       Int             @map("broadcast_id")
  userId            BigInt          @map("user_id")
  status            RecipientStatus @default(pending)
  error             String?
  telegramMessageId Int?            @map("telegram_message_id")
  sentAt            DateTime?       @map("sent_at") @db.Timestamptz

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([broadcastId, userId])
  @@index([broadcastId, status])
  @@map("broadcast_recipients")
}

/**
 * Foydalanuvchiga yuborilgan bildirishnomalar (buyurtma holati, admin xabari va h.k.)
 */
model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  kind      NotificationKind
  text      String
  // Telegram'ga yetkazildimi (bloklagan bo'lsa false)
  delivered Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

/**
 * Admin paneldan boshqariladigan buyruqlar: javob matni bazadan olinadi
 */
model BotCommand {
  id          Int      @id @default(autoincrement())
  command     String   @unique
  description String   @default("")
  response    String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("bot_commands")
}

/**
 * Telegram'dagi "Menu" tugmasi ro'yxati (setMyCommands)
 */
model BotMenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  command     String   @unique
  description String
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("bot_menu")
}

model ActivityLog {
  id          BigInt   @id @default(autoincrement())
  panelUserId Int?     @map("panel_user_id")
  action      String
  description String
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  panelUser PanelUser? @relation(fields: [panelUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([panelUserId])
  @@map("activity_logs")
}

// Bir nechta server (instance) ishlaganda fon vazifasini faqat bittasi bajaradi: muddatli "lease".
// Egasi o'lsa, lease muddati tugagach boshqa instans oladi.
model JobLock {
  name      String   @id
  owner     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("job_locks")
}

// Qisqa muddatli suhbat holati (masalan, admin rad etish sababini yozmoqda) — barcha instanslar uchun umumiy
model BotState {
  key       String   @id
  value     Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("bot_state")
}

// Marketing: kampaniya (deep link) — t.me/bot?start=<code>.
// Kod qaysi mahsulotga olib borishini baza belgilaydi (frontend/bot da hardcode yo'q)
model CampaignLink {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  // Admin uchun nom (masalan "Instagram story — sentabr")
  name        String?
  productId   Int      @map("product_id")
  source      String
  campaign    String?
  medium      String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy  PanelUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  visits     LinkVisit[]
  orders     Order[]
  lastUsers  User[]      @relation("UserLastLink")
  firstUsers User[]      @relation("UserFirstLink")
  clicks     LinkClick[]

  @@index([productId])
  @@map("campaign_links")
}

enum LinkVisitVia {
  bot
  // Olib tashlangan Mini App orqali kirishlar — faqat tarixiy yozuvlar uchun (yangilari yozilmaydi)
  webapp
}

// Link orqali har bir kirish (takroriy bosishlar 30 daqiqa ichida bitta hisoblanadi)
model LinkVisit {
  id        BigInt       @id @default(autoincrement())
  linkId    Int          @map("link_id")
  userId    BigInt       @map("user_id")
  via       LinkVisitVia
  isNewUser Boolean      @default(false) @map("is_new_user")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  link CampaignLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([userId, linkId, createdAt])
  @@map("link_visits")
}

// Tracking redirect (/l/<kod>) orqali bosishlar — Telegram t.me bosishni botga bildirmaydi.
// IP saqlanmaydi: faqat kunlik tuzli hash (unique bosishlarni sanash uchun)
model LinkClick {
  id          BigInt   @id @default(autoincrement())
  linkId      Int      @map("link_id")
  visitorHash String   @map("visitor_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  link CampaignLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@map("link_clicks")
}

// Texnik xatolar (logger.error/fatal) — panelda "Xatoliklar" bo'limi. Bir xil xato bitta yozuvga
// guruhlanadi (fingerprint), takrorlanganda count va last_seen_at yangilanadi.
model ErrorLog {
  id          BigInt    @id @default(autoincrement())
  fingerprint String    @unique
  level       String
  message     String
  errorType   String?   @map("error_type")
  errorText   String?   @map("error_text")
  stack       String?
  context     Json?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz

  @@index([resolvedAt, lastSeenAt])
  @@index([lastSeenAt])
  @@map("error_logs")
}

enum LessonMediaType {
  video
  // Kompyuterdan "fayl sifatida" yuborilgan video (sendDocument bilan yuboriladi)
  document
}

// Kurs darsi (video). Fayl serverga yuklab olinmaydi: Telegram file_id saqlanadi va mijozga shu orqali
// yuboriladi. file_id faqat shu bot uchun amal qiladi — bot tokeni boshqa botga almashtirilsa, videolar qayta yuborilishi kerak
model Lesson {
  id                   Int             @id @default(autoincrement())
  productId            Int             @map("product_id")
  title                String
  description          String?
  caption              String?
  mediaType            LessonMediaType @default(video) @map("media_type")
  telegramFileId       String          @map("telegram_file_id")
  telegramFileUniqueId String          @map("telegram_file_unique_id")
  // Admin video yuborgan xabar (bot chatida)
  telegramChatId       BigInt?         @map("telegram_chat_id")
  telegramMessageId    BigInt?         @map("telegram_message_id")
  fileName             String?         @map("file_name")
  mimeType             String?         @map("mime_type")
  // 2 GB dan katta bo'lishi mumkin (Premium: 4 GB) — BigInt
  fileSize             BigInt?         @map("file_size")
  duration             Int?
  width                Int?
  height               Int?
  sortOrder            Int             @default(0) @map("sort_order")
  createdById          Int?            @map("created_by")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy Admin?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Bitta video bitta kursga ikki marta qo'shilmaydi
  @@unique([productId, telegramFileUniqueId])
  @@index([productId, sortOrder])
  @@map("lessons")
}
